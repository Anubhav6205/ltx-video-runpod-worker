# Server
PORT=8000
LOG_LEVEL=INFO
WORKDIR=/workspace
OUTPUT_DIR=/workspace/outputs

# Concurrency / timeouts
MAX_CONCURRENT_JOBS=1
IMAGE_DOWNLOAD_TIMEOUT_S=30
GENERATE_TIMEOUT_S=300

# Hugging Face / caching
HF_TOKEN=
HF_HOME=/workspace/models/hf_home
HF_HUB_CACHE=/workspace/models/hf_hub
TRANSFORMERS_CACHE=/workspace/models/hf_transformers
HF_HUB_ENABLE_HF_TRANSFER=1

# LTX-Video model selection
LTX_REPO_ID=Lightricks/LTX-Video
LTX_TRANSFORMER_FILENAME=ltxv-2b-0.9.8-distilled.safetensors
TORCH_DTYPE=bfloat16
DEFAULT_WIDTH=704
DEFAULT_HEIGHT=512
DEFAULT_FPS=24
DEFAULT_STEPS=8
DEFAULT_GUIDANCE_SCALE=1.0
DEFAULT_NEGATIVE_PROMPT=worst quality, blurry, jittery, distorted, watermark, text

# Storage (Cloudflare R2) - default
STORAGE_BACKEND=r2
STORAGE_KEY_PREFIX=clips
R2_BUCKET=
R2_ACCOUNT_ID=
# Optional override (otherwise derived from R2_ACCOUNT_ID)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Optional (recommended): If set, returned URL is `${R2_PUBLIC_BASE_URL}/{key}` (supports `{bucket}` placeholder)
R2_PUBLIC_BASE_URL=
# Signed URL TTL (used when R2_PUBLIC_BASE_URL is empty)
R2_PRESIGN_TTL_S=3600

# Storage (Google Cloud Storage) - optional/legacy
# To use GCS instead, set: STORAGE_BACKEND=gcs
GCS_BUCKET=video_gen_workflow
GCS_PROJECT_ID=dulcet-answer-482513-v7
GCS_SERVICE_ACCOUNT_KEY=/workspace/gcs-service-account.json
GCS_PUBLIC_BASE=
GCS_MAKE_PUBLIC=false
GCS_SIGNED_URL_TTL_S=3600

# /test_r2 endpoint (diagnostics)
# NOTE: keep disabled in public deployments.
TEST_R2_ALLOW_ANY_PATH=false
# Additional allowed roots for mp4_path (separated by ';' on Windows, ':' on Linux)
TEST_R2_ALLOWED_ROOTS=

# Optional: health/readiness warmup
WARMUP_ON_START=false
WARMUP_PROMPT=A person walking in a park
WARMUP_IMAGE_URL=
