# LTX-Video Worker Dockerfile with Pre-baked Weights
# Downloads model weights DURING BUILD for instant pod startup
# Warning: Creates ~37GB image (12GB base + 25GB weights)

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    git \
    ffmpeg \
    curl \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install build tools
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements first for better caching
COPY requirements.txt /app/requirements.txt

# Install PyTorch with CUDA 12.1 support for RTX 4090
# Installed separately to ensure correct CUDA version
RUN python3 -m pip install --no-cache-dir \
    torch==2.10.0 \
    torchvision==0.25.0 \
    --index-url https://download.pytorch.org/whl/cu121

# Install remaining Python dependencies
# This layer is cached unless requirements.txt changes
RUN python3 -m pip install --no-cache-dir -r requirements.txt

# Copy application code (needed for downloading weights)
COPY app/ /app/app/
COPY entrypoint.sh /app/entrypoint.sh

# Make entrypoint executable
RUN chmod +x /app/entrypoint.sh

# Create directories for models and outputs
RUN mkdir -p /models/hf_home /models/hf_hub /models/hf_transformers /workspace/outputs

# Set environment variables for weight download
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/hf_home
ENV HF_HUB_CACHE=/models/hf_hub
ENV TRANSFORMERS_CACHE=/models/hf_transformers
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# ========================================
# PRE-DOWNLOAD MODEL WEIGHTS INTO IMAGE
# This adds ~25GB to the image but eliminates startup download time
# ========================================
RUN echo "================================================" && \
    echo "Downloading LTX-Video weights into Docker image..." && \
    echo "This will take 15-20 minutes but only happens once during build" && \
    echo "================================================" && \
    python3 -c "from app.bootstrap import init_model; init_model()" && \
    echo "================================================" && \
    echo "Weights successfully baked into image!" && \
    du -sh /models/hf_hub && \
    echo "================================================"

# Runtime environment variables (can be overridden)
ENV PORT=8000
ENV WORKDIR=/workspace
ENV OUTPUT_DIR=/workspace/outputs

# Expose HTTP port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run entrypoint script
ENTRYPOINT ["/app/entrypoint.sh"]
